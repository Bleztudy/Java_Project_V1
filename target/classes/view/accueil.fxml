<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.*?>

<VBox fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AccueilController" stylesheets="@styles.css">
    
    <!-- Barre de navigation -->
    <HBox styleClass="navbar">
        <Label text="📚 BiblioTech" styleClass="logo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Accueil" styleClass="nav-btn" onAction="#goToAccueil" />
        <Button text="Catalogue" styleClass="nav-btn" onAction="#goToCatalogue" />
        <Button text="Emprunts" styleClass="nav-btn" onAction="#goToEmprunt" />
        <Button text="Admin" styleClass="nav-btn" onAction="#goToAdmin" />
        <ToggleButton fx:id="themeToggle" onAction="#toggleTheme" text="🌙" styleClass="theme-btn" />
    </HBox>
    
    <!-- Carrousel background (StackPane pour overlay) -->
    <StackPane VBox.vgrow="ALWAYS" styleClass="carousel-container">
        <StackPane fx:id="carouselPane" styleClass="carousel-bg">
            <!-- Les images seront ajoutées dynamiquement -->
        </StackPane>
        
        <!-- Contenu par-dessus le carrousel -->
        <VBox alignment="CENTER" spacing="30" styleClass="hero-content">
            <Text text="Bienvenue à la Bibliothèque" styleClass="hero-title" />
            <Text text="Découvrez, empruntez et lisez des milliers de livres" styleClass="hero-subtitle" />
            <Button text="📖 Lire un livre" styleClass="hero-btn" onAction="#goToCatalogue" />
            
            <!-- Statistiques -->
            <HBox spacing="50" styleClass="stats-container">
                <VBox alignment="CENTER">
                    <Text fx:id="statLivres" text="0" styleClass="stat-number" />
                    <Text text="Livres disponibles" styleClass="stat-label" />
                </VBox>
                <VBox alignment="CENTER">
                    <Text fx:id="statEtudiants" text="0" styleClass="stat-number" />
                    <Text text="Étudiants inscrits" styleClass="stat-label" />
                </VBox>
                <VBox alignment="CENTER">
                    <Text fx:id="statEmprunts" text="0" styleClass="stat-number" />
                    <Text text="Emprunts en cours" styleClass="stat-label" />
                </VBox>
            </HBox>
        </VBox>
    </StackPane>
    
</VBox>