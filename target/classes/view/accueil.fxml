<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AccueilController" stylesheets="@styles.css" style="-fx-background-color: #f0f4f8;">

    <HBox styleClass="navbar">
        <Label text="📚 BiblioTech" styleClass="logo"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Accueil" styleClass="nav-btn" onAction="#goToAccueil"/>
        <Button text="Catalogue" styleClass="nav-btn" onAction="#goToCatalogue"/>
        <Button text="Admin" styleClass="nav-btn-admin" onAction="#goToAdmin"/>
    </HBox>
    
    <StackPane fx:id="carouselPane" VBox.vgrow="ALWAYS">
        <VBox styleClass="hero-content" alignment="CENTER" spacing="30">
            <Text text="Bienvenue à la Bibliothèque" styleClass="hero-title"/>
            <Text text="Découvrez, empruntez et lisez des milliers de livres" styleClass="hero-subtitle"/>
            <Button text="📖 Lire un livre" styleClass="hero-btn" onAction="#goToCatalogue"/>
            
            <HBox styleClass="stats-container" spacing="50">
                <VBox alignment="CENTER">
                    <Text fx:id="statLivres" text="0" styleClass="stat-number"/>
                    <Text text="Livres disponibles" styleClass="stat-label"/>
                </VBox>
                <VBox alignment="CENTER">
                    <Text fx:id="statEtudiants" text="0" styleClass="stat-number"/>
                    <Text text="Étudiants inscrits" styleClass="stat-label"/>
                </VBox>
                <VBox alignment="CENTER">
                    <Text fx:id="statEmprunts" text="0" styleClass="stat-number"/>
                    <Text text="Emprunts en cours" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>
    
</VBox>