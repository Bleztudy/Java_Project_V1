<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CatalogueController" stylesheets="@styles.css">
    
    <HBox styleClass="navbar">
        <Label text="📚 BiblioTech" styleClass="logo" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Accueil" styleClass="nav-btn" onAction="#goToAccueil" />
        <Button text="Catalogue" styleClass="nav-btn" onAction="#goToCatalogue" />
        <Button text="Emprunts" styleClass="nav-btn" onAction="#goToEmprunt" />
        <Button text="Admin" styleClass="nav-btn" onAction="#goToAdmin" />
        <ToggleButton fx:id="themeToggle" onAction="#toggleTheme" text="🌙" styleClass="theme-btn" />
    </HBox>
    
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="20" styleClass="catalogue-container">
            <Label text="📖 Catalogue des livres" styleClass="page-title" />
            
            <!-- Barre de recherche -->
            <HBox spacing="10" styleClass="search-bar">
                <TextField fx:id="searchField" promptText="Rechercher un livre..." HBox.hgrow="ALWAYS" />
                <Button text="🔍 Rechercher" onAction="#rechercherLivres" />
            </HBox>
            
            <!-- Grille de livres (FlowPane pour les vignettes) -->
            <FlowPane fx:id="livresGrid" hgap="20" vgap="20" alignment="CENTER" styleClass="books-grid" />
            
        </VBox>
    </ScrollPane>
    
</VBox>