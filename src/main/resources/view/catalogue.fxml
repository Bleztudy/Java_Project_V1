<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CatalogueController" stylesheets="@styles.css" style="-fx-background-color: #f0f4f8;">

    <HBox styleClass="navbar">
        <Label text="BiblioTech" styleClass="logo"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Accueil" styleClass="nav-btn" onAction="#goToAccueil"/>
        <Button text="Catalogue" styleClass="nav-btn" onAction="#goToCatalogue"/>
        <Button text="Admin" styleClass="nav-btn-admin" onAction="#goToAdmin"/>
    </HBox>
    
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="20" style="-fx-padding: 20;">
            <Text text="Catalogue des livres" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-fill: #2c3e50;"/>
            
            <HBox spacing="10">
                <ComboBox fx:id="filterCombo" promptText="Filtrer par catégorie" style="-fx-pref-width: 150; -fx-padding: 8; -fx-background-radius: 25;"/>
                <TextField fx:id="searchField" promptText="Rechercher un livre..." HBox.hgrow="ALWAYS" style="-fx-padding: 10; -fx-background-radius: 25; -fx-border-radius: 25;"/>
                <Button text="Rechercher" onAction="#rechercherLivres" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 25; -fx-background-radius: 25; -fx-cursor: hand;"/>
            </HBox>
            
            <FlowPane fx:id="livresGrid" hgap="20" vgap="20" alignment="CENTER"/>
            
        </VBox>
    </ScrollPane>
    
</VBox>