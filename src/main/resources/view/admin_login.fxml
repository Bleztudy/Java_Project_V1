<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.AdminLoginController" stylesheets="@styles.css" styleClass="login-container">
    
    <VBox styleClass="login-card">
        <Text text="🔐 Administration" styleClass="login-title" />
        <Text text="Accès réservé au personnel" style="-fx-font-size: 14px; -fx-fill: #7f8c8d;" />
        
        <TextField fx:id="usernameField" promptText="Nom d'utilisateur" styleClass="login-field" />
        <PasswordField fx:id="passwordField" promptText="Mot de passe" styleClass="login-field" />
        
        <Button text="Se connecter" onAction="#handleLogin" styleClass="login-btn" />
        
        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" />
    </VBox>
    
</VBox>